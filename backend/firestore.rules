rules_version = '2';

// Firestore security rules.
//
// This API uses the Admin SDK, which bypasses these rules entirely, so every permission
// check that matters is enforced in Express (see src/middleware/auth.js). These rules are
// the second line of defence: if anything ever talks to Firestore directly with a client
// SDK, or if a database URL leaks, the default answer is no.
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Tier and role are carried as custom claims, set by the API when they change.
    function isAdminOf(orgId) {
      return signedIn()
        && request.auth.token.role == 'admin'
        && request.auth.token.organisationId == orgId;
    }

    // A user may read their own record. The website may create it once at sign-up, but
    // only as a plain free/member account with their real login email. Tier and role can
    // only be changed by the server, so nobody can grant themselves premium or admin.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
             'displayName', 'email', 'organisationId', 'organisationName',
             'requestedPlan', 'role', 'scanCount', 'subscription', 'tier',
             'disabled', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.requestedPlan in ['student', 'organisation']
        && request.resource.data.tier == 'free'
        && request.resource.data.role == 'member'
        && request.resource.data.organisationId == null
        && request.resource.data.scanCount == 0
        && request.resource.data.disabled == false
        && request.resource.data.subscription.keys().hasOnly(['status', 'startedAt', 'cancelledAt'])
        && request.resource.data.subscription.status == 'none'
        && request.resource.data.subscription.startedAt == null
        && request.resource.data.subscription.cancelledAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    // Members may read their organisation. Only the API changes it.
    match /organisations/{orgId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }

    // Invitations hold a token hash, so they are never client readable. Accepting one
    // goes through the API, which verifies the token and updates several documents in a
    // single transaction.
    match /invitations/{invitationId} {
      allow read, write: if false;
    }

    // Student verification codes are only six digits, so even their hash must stay out of
    // reach of the client: trying all million values would take seconds.
    match /studentVerifications/{userId} {
      allow read, write: if false;
    }

    // A scan belongs to the person who ran it. Admin access to a member's scans is
    // granted by the API instead, because it also writes an audit entry for the read.
    match /scans/{scanId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    // Flags are an admin workflow and are only reachable through the API.
    match /flags/{flagId} {
      allow read: if isAdminOf(resource.data.organisationId);
      allow write: if false;
    }

    // The audit log is append-only, and only the server appends to it. Admins read it
    // through the API so the query can be scoped to their own organisation.
    match /auditLog/{entryId} {
      allow read, write: if false;
    }

    // ===== Stripe extension =====
    // A user can start a checkout for themselves and see their own
    // payments and subscriptions. Only the extension (server) writes the
    // results, so a payment can't be faked from the browser.
    match /customers/{uid} {
      allow read: if isOwner(uid);

      match /checkout_sessions/{id} {
        allow read, create: if isOwner(uid);
      }
      match /subscriptions/{id} {
        allow read: if isOwner(uid);
      }
      match /payments/{id} {
        allow read: if isOwner(uid);
      }
    }

    // The product and price list is public, so the plans page can show it.
    match /products/{id} {
      allow read: if true;

      match /prices/{id} {
        allow read: if true;
      }
      match /tax_rates/{id} {
        allow read: if true;
      }
    }

    // Anything not named above is denied, so a new collection is closed until rules for
    // it are written on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
