# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API.
# The PySide6 desktop app does not send an Origin header, so this only affects browsers.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Firebase Admin SDK (server side) ---
# From the Firebase console: Project settings > Service accounts > Generate new private key.
# Either point at the downloaded JSON file:
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# ...or supply the three fields directly (useful on hosts that only allow env vars).
# The private key must keep its \n escapes when pasted into a single line.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Firebase Web API key (client side key, used for email/password sign-in) ---
# From the Firebase console: Project settings > General > Web API Key.
# The Admin SDK cannot verify passwords, so login calls Google's Identity Toolkit
# REST API with this key. It is not a secret in the way the service account is,
# but keep it out of the repository anyway.
FIREBASE_WEB_API_KEY=

# --- AI explanation layer (optional) ---
# Leave blank to disable AI explanations. Findings still work without it.
# From console.groq.com -- no card required for the free tier.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Outbound email ---
# Needed in production: student verification codes are sent by email, and the free
# plan stays locked until one arrives. Everything else emailed is a notification only.
# Without it, a development server prints codes to its log instead.
# Test the settings with:  npm run email:test -- you@example.com
#
# Option 1, Mailgun: the private API key and your sending domain. A sandbox domain only
# delivers to authorized recipients added in the Mailgun dashboard, so real students
# need a domain you own, added and verified in Mailgun.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional. Defaults to "BioAudit <postmaster@MAILGUN_DOMAIN>".
MAILGUN_FROM=
# Only for an EU-region domain: https://api.eu.mailgun.net
MAILGUN_URL=
#
# Option 2, any SMTP server. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER is the Gmail
# address and SMTP_PASS a 16-character App Password from
# https://myaccount.google.com/apppasswords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Who emails come from. Defaults to SMTP_USER; set it if your provider signs in with a
# username that is not an email address.
SMTP_FROM=

# --- Student verification ---
# Free personal accounts must verify a university email before running assessments.
# .ac.uk, .edu, .edu.xx and .ac.xx domains are accepted automatically; list any other
# university domains here, comma-separated (subdomains are included).
STUDENT_EMAIL_DOMAINS=

# --- Tier limits ---
# How many scans a free account keeps. The oldest is removed once this is exceeded.
FREE_HISTORY_LIMIT=10
# AI explanations a free account may generate per calendar month.
FREE_AI_MONTHLY_LIMIT=20
# Premium keeps everything and is uncapped, so no limits are configured for it.
